@prefix p2:   <https://w3id.org/laquereric/cpcp/ps1-p2/ns#> .
@prefix cpcp: <https://w3id.org/laquereric/cpcp/ns#> .
@prefix jrl:  <https://w3id.org/laquereric/json-rpc-ld/ns#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/laquereric/cpcp/ps1-p2/ontology/1.0.0>
  a owl:Ontology ;
  owl:versionIRI <https://w3id.org/laquereric/cpcp/ps1-p2/ontology/1.0.0> ;
  owl:versionInfo "1.0.0" ;
  owl:imports <https://w3id.org/laquereric/cpcp/ontology/base/1.0.0> ;
  rdfs:label "CPCP PS1-P2 reference-passing ontology and shapes"@en ;
  rdfs:comment "Self-contained release aggregate for JSON-RPC-LD-PS1-P2 (Context-by-reference for agents): profile vocabulary, operation individuals (from the CID), and closed SHACL shapes. Vendors the base/core terms it uses so it opens in Protege without resolving remote imports."@en ;
  rdfs:seeAlso <https://github.com/laquereric/JSON-RPC-LD-PS1-P2/blob/main/cid/cid.json> ,
               <https://github.com/laquereric/JSON-RPC-LD-PS1-P2> .

# ---- Vendored core + base terms (canonical IRIs) -----------------------------
jrl:Envelope a owl:Class ; rdfs:label "JSON-RPC-LD envelope"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/json-rpc-ld/ontology/core/1.0.0> .
jrl:Operation a owl:Class ; rdfs:label "operation"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/json-rpc-ld/ontology/core/1.0.0> .
jrl:operationId a owl:DatatypeProperty ; rdfs:domain jrl:Envelope ; rdfs:range xsd:string ; rdfs:label "operation identifier"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/json-rpc-ld/ontology/core/1.0.0> .
cpcp:Envelope a owl:Class ; rdfs:subClassOf jrl:Envelope ; rdfs:label "CPCP envelope"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ontology/base/1.0.0> .
cpcp:Operation a owl:Class ; rdfs:subClassOf jrl:Operation ; rdfs:label "CPCP operation"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ontology/base/1.0.0> .
cpcp:CID a owl:Class ; rdfs:label "Cyborg Interface Descriptor"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ontology/base/1.0.0> .
cpcp:Profile a owl:Class ; rdfs:label "CPCP profile"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ontology/base/1.0.0> .
cpcp:Direction a owl:Class ; rdfs:label "operation direction"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ontology/base/1.0.0> .
cpcp:Ledger a owl:Class ; rdfs:label "ledger"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ontology/base/1.0.0> .
cpcp:CanonicalLedger a owl:Class ; rdfs:subClassOf cpcp:Ledger ; rdfs:label "canonical ledger"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ontology/base/1.0.0> .
cpcp:Record a owl:Class ; rdfs:label "record"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ontology/base/1.0.0> .
cpcp:CanonicalRecord a owl:Class ; rdfs:subClassOf cpcp:Record ; rdfs:label "canonical record"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ontology/base/1.0.0> .
cpcp:Insight a owl:Class ; rdfs:subClassOf cpcp:CanonicalRecord ; rdfs:label "insight"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ontology/base/1.0.0> .
cpcp:Receipt a owl:Class ; rdfs:subClassOf cpcp:CanonicalRecord ; rdfs:label "receipt"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ontology/base/1.0.0> .
cpcp:invokesOperation a owl:ObjectProperty ; rdfs:domain cpcp:Envelope ; rdfs:range cpcp:Operation ; rdfs:label "invokes operation"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ontology/base/1.0.0> .
cpcp:hasPayload a owl:ObjectProperty ; rdfs:domain cpcp:Envelope ; rdfs:range cpcp:Record ; rdfs:label "has payload"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ontology/base/1.0.0> .
cpcp:storedIn a owl:ObjectProperty ; rdfs:domain cpcp:Record ; rdfs:range cpcp:Ledger ; rdfs:label "stored in"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ontology/base/1.0.0> .
cpcp:hasDirection a owl:ObjectProperty ; rdfs:domain cpcp:Operation ; rdfs:range cpcp:Direction ; rdfs:label "has direction"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ontology/base/1.0.0> .
cpcp:hasCID a owl:ObjectProperty ; rdfs:domain cpcp:Profile ; rdfs:range cpcp:CID ; rdfs:label "has CID"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ontology/base/1.0.0> .
cpcp:declaresOperation a owl:ObjectProperty ; rdfs:domain cpcp:CID ; rdfs:range cpcp:Operation ; rdfs:label "declares operation"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ontology/base/1.0.0> .
cpcp:references a owl:ObjectProperty ; rdfs:domain cpcp:Record ; rdfs:range rdfs:Resource ; rdfs:label "references"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ontology/base/1.0.0> .
cpcp:PULL a owl:NamedIndividual, cpcp:Direction ; rdfs:label "PULL"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ontology/base/1.0.0> .
cpcp:PUSH a owl:NamedIndividual, cpcp:Direction ; rdfs:label "PUSH"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ontology/base/1.0.0> .

# ---- P2 profile vocabulary (reference-passing) -------------------------------
p2:Preview a owl:Class ; rdfs:subClassOf cpcp:Record ;
  rdfs:label "preview"@en ;
  rdfs:comment "A bounded preview that carries an @id reference instead of the full payload; the payload stays in BACK (Context by reference)."@en ;
  rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ps1-p2/ontology/1.0.0> .
p2:previewText a owl:DatatypeProperty ; rdfs:domain p2:Preview ; rdfs:range xsd:string ;
  rdfs:label "preview text"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ps1-p2/ontology/1.0.0> .
p2:summary a owl:DatatypeProperty ; rdfs:domain cpcp:Insight ; rdfs:range xsd:string ;
  rdfs:label "insight summary"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ps1-p2/ontology/1.0.0> .

p2:Profile a owl:NamedIndividual, cpcp:Profile ; rdfs:label "JSON-RPC-LD-PS1-P2 (reference-passing)"@en ; cpcp:hasCID p2:cid ;
  rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ps1-p2/ontology/1.0.0> .
p2:cid a owl:NamedIndividual, cpcp:CID ; rdfs:label "PS1-P2 CID"@en ;
  cpcp:declaresOperation <https://threedot.dev/op/ps1-p2/methods.list> ,
                         <https://threedot.dev/op/ps1-p2/canonical.pull> ,
                         <https://threedot.dev/op/ps1-p2/canonical.get> ,
                         <https://threedot.dev/op/ps1-p2/insight.push> ;
  rdfs:seeAlso <https://github.com/laquereric/JSON-RPC-LD-PS1-P2/blob/main/cid/cid.json> ;
  rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ps1-p2/ontology/1.0.0> .
p2:canonicalLedger a owl:NamedIndividual, cpcp:CanonicalLedger ; rdfs:label "P2 canonical ledger"@en ; rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ps1-p2/ontology/1.0.0> .

<https://threedot.dev/op/ps1-p2/methods.list> a owl:NamedIndividual, cpcp:Operation ;
  rdfs:label "methods.list"@en ; cpcp:hasDirection cpcp:PULL ;
  rdfs:comment "BACK publishes its typed method surface."@en ;
  rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ps1-p2/ontology/1.0.0> .
<https://threedot.dev/op/ps1-p2/canonical.pull> a owl:NamedIndividual, cpcp:Operation ;
  rdfs:label "canonical.pull"@en ; cpcp:hasDirection cpcp:PULL ;
  rdfs:comment "Read bounded previews + @id references (Context by reference); payloads stay in BACK."@en ;
  rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ps1-p2/ontology/1.0.0> .
<https://threedot.dev/op/ps1-p2/canonical.get> a owl:NamedIndividual, cpcp:Operation ;
  rdfs:label "canonical.get"@en ; cpcp:hasDirection cpcp:PULL ;
  rdfs:comment "Dereference one record by @id on demand."@en ;
  rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ps1-p2/ontology/1.0.0> .
<https://threedot.dev/op/ps1-p2/insight.push> a owl:NamedIndividual, cpcp:Operation ;
  rdfs:label "insight.push"@en ; cpcp:hasDirection cpcp:PUSH ;
  rdfs:comment "FRONT publishes one Insight to BACK (FRONT->BACK); returns a receipt."@en ;
  rdfs:isDefinedBy <https://w3id.org/laquereric/cpcp/ps1-p2/ontology/1.0.0> .

# ---- P2 closed SHACL shapes --------------------------------------------------
p2:EnvelopeShape a sh:NodeShape ;
  rdfs:label "PS1-P2 closed envelope shape"@en ;
  sh:targetClass cpcp:Envelope ; sh:closed true ; sh:ignoredProperties ( rdf:type ) ;
  sh:property [ sh:path jrl:operationId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path cpcp:invokesOperation ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cpcp:Operation ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path cpcp:hasPayload ; sh:maxCount 1 ; sh:class cpcp:Record ; sh:nodeKind sh:IRI ] .

p2:PreviewShape a sh:NodeShape ;
  rdfs:label "PS1-P2 closed preview shape"@en ;
  rdfs:comment "A preview carries a bounded text and exactly one @id reference; never the full payload."@en ;
  sh:targetClass p2:Preview ; sh:closed true ; sh:ignoredProperties ( rdf:type ) ;
  sh:property [ sh:path p2:previewText ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path cpcp:references ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

p2:InsightShape a sh:NodeShape ;
  rdfs:label "PS1-P2 closed Insight shape"@en ;
  sh:targetClass cpcp:Insight ; sh:closed true ; sh:ignoredProperties ( rdf:type ) ;
  sh:property [ sh:path p2:summary ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path cpcp:references ; sh:nodeKind sh:IRI ] .
