    {
      "method": "GET",
      "path": "/up"
    }
  ],
  "roles": {
    "back": [
      {
        "mount": "/_cpcp"
      }
    ],
    "front": [
      {
        "method": "GET",
        "path": "/"
      },
      {
        "method": "POST",
        "path": "/notes"
      },
      {
        "method": "GET",
        "path": "/governance"
      }
    ],
    "vault": [
      {
        "method": "POST",
        "path": "/_cpcp/rpc"
      }
    ],
    "config": [
      {
        "method": "GET",
        "path": "/"
      },
      {
        "method": "POST",
        "path": "/secrets"
      },
      {
        "method": "GET",
        "path": "/catalog"
      },
      {
        "method": "GET",
        "path": "/placements"
      },
      {
        "method": "POST",
        "path": "/placements"
      }
    ],
    "shape": [
      {
        "method": "GET",
        "path": "/_cpcp/up"
      },
      {
        "method": "GET",
        "path": "/_cpcp/shapes.json"
      },
      {
        "method": "GET",
        "path": "/_cpcp/shapes/:digest"
      }
    ],
    "bus": [
      {
        "method": "POST",
        "path": "/_cpcp/rpc"
      }
    ],
    "backjob": [],
    "persist": [
      {
        "method": "POST",
        "path": "/_cpcp/rpc"
      }
    ]
  }
}
