# OS / editor
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Dependencies / build
node_modules/
vendor/bundle/
tmp/
log/
*.log
dist/
build/
.bundle/

# Secrets — never commit
.env
.env.*

# Agent-level state. Provider API keys and anything else an agent needs to
# persist across container teardown live here, NOT in a docker volume: a volume
# dies with `down -v`, and a key you have to re-enter after every teardown ends
# up pasted somewhere worse. Ignored wholesale, including anything added later.
.agent/
*.pem
*.key
secrets.*


# CI gate evidence artifacts (generated; uploaded as workflow artifacts, not committed)
evidence/

# 3dot extension per-workspace journey state (cid.json is a committed discovery seed - keep it tracked)
**/.threedot/journey.json
.mm_tmp/

# Python bytecode. Not just noise: capture_shape_baseline.py refuses to run on a
# dirty tree, and importing tooling/population.py writes __pycache__ -- so the
# script made ITSELF dirty and then refused, on every clean checkout.
__pycache__/
*.pyc
.venv/
