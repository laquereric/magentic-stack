{
  "name": "threedot",
  "displayName": "3dot — Cyborg Interface",
  "description": "Type … or three. to summon CID capabilities as language-native APIs. threedot.dev",
  "version": "0.0.5",
  "publisher": "laquereric",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "threedot.embedCID",
        "title": "3dot: Embed Cyborg Interface Descriptor (CID)"
      },
      {
        "command": "threedot.showCapabilities",
        "title": "3dot: Show Capabilities"
      },
      {
        "command": "threedot.insertCapability",
        "title": "3dot: Insert Capability…"
      },
      {
        "command": "threedot.openCID",
        "title": "3dot: Open CID",
        "icon": "$(json)"
      },
      {
        "command": "threedot.reloadCID",
        "title": "3dot: Reload CID",
        "icon": "$(refresh)"
      },
      {
        "command": "threedot.showLog",
        "title": "3dot: Show Log"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "threedot.openCID",
          "when": "view == threedotCaps",
          "group": "navigation"
        },
        {
          "command": "threedot.reloadCID",
          "when": "view == threedotCaps",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "threedot.insertCapability",
          "when": "resourceLangId == python || resourceLangId == typescript",
          "group": "1_modification@9"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "threedotCaps",
        "contents": "No CID operations yet.\n[Embed a starter CID](command:threedot.embedCID)\n\nType … in a Python file once a CID is present."
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "threedot",
          "title": "3dot",
          "icon": "media/threedot.svg"
        }
      ]
    },
    "views": {
      "threedot": [
        {
          "id": "threedotCaps",
          "name": "Cyborg Interface (CID)"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": ".threedot/cid.json",
        "url": "./schema/cid.schema.json"
      }
    ],
    "configuration": {
      "title": "3dot",
      "properties": {
        "threedot.autoImport": {
          "type": "boolean",
          "default": true,
          "description": "Insert `import three` when completing a Python capability that needs it."
        },
        "threedot.callLabels": {
          "type": "string",
          "enum": ["endOfLine", "inlay", "codelens", "both", "off"],
          "default": "endOfLine",
          "description": "Where to show `3dot · role → Shape` on three.* calls. Cursor often does not draw CodeLens; endOfLine puts the label after the call."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test:parse": "npm run compile && node scripts/check-parse.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/laquereric/threedot-vscode"
  },
  "keywords": [
    "cyborg",
    "threedot",
    "json-rpc-ld",
    "lsp",
    "agent"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  }
}
