{
  "name": "threedot",
  "displayName": "3dot — Cyborg Interface",
  "description": "Type … or three. to summon CID capabilities as language-native APIs. Cyborg Journey wizard for Rails/JS spines. threedot.dev",
  "version": "0.0.6",
  "publisher": "laquereric",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "threedot.embedCID",
        "title": "3dot: Embed Cyborg Interface Descriptor (CID)"
      },
      {
        "command": "threedot.showCapabilities",
        "title": "3dot: Show Capabilities"
      },
      {
        "command": "threedot.insertCapability",
        "title": "3dot: Insert Capability…"
      },
      {
        "command": "threedot.openCID",
        "title": "3dot: Open CID",
        "icon": "$(json)"
      },
      {
        "command": "threedot.reloadCID",
        "title": "3dot: Reload CID",
        "icon": "$(refresh)"
      },
      {
        "command": "threedot.showLog",
        "title": "3dot: Show Log"
      },
      {
        "command": "threedot.journey.openPanel",
        "title": "3dot: Open Cyborg Journey Panel",
        "icon": "$(map)"
      },
      {
        "command": "threedot.journey.start",
        "title": "3dot: Start Cyborg Journey"
      },
      {
        "command": "threedot.journey.resume",
        "title": "3dot: Resume Cyborg Journey"
      },
      {
        "command": "threedot.journey.selectPersona",
        "title": "3dot: Select Journey Persona"
      },
      {
        "command": "threedot.journey.selectIntegration",
        "title": "3dot Journey: Select Integration (Rails)"
      },
      {
        "command": "threedot.journey.defineOperations",
        "title": "3dot Journey: Define Operations (Rails)"
      },
      {
        "command": "threedot.journey.defineInterfacePromise",
        "title": "3dot Journey: Define Interface Promise (JS)"
      },
      {
        "command": "threedot.journey.openEvidence",
        "title": "3dot Journey: Open Evidence"
      },
      {
        "command": "threedot.cpcp.planBoundary",
        "title": "3dot CPCP: Plan Pod Boundary"
      },
      {
        "command": "threedot.cpcp.generateBindRun",
        "title": "3dot CPCP: Generate / Bind / Run"
      },
      {
        "command": "threedot.cpcp.verify",
        "title": "3dot CPCP: Verify (mmg-cpcp-verify)"
      },
      {
        "command": "threedot.cpcp.deploy",
        "title": "3dot CPCP: Deploy Pod"
      },
      {
        "command": "threedot.cpcp.run",
        "title": "3dot CPCP: Run Pod"
      },
      {
        "command": "threedot.mmgScape.discoverQualify",
        "title": "3dot Scape: Discover & Qualify"
      },
      {
        "command": "threedot.scape.openObservation",
        "title": "3dot Scape: Open Observation"
      },
      {
        "command": "threedot.scape.discoverChoices",
        "title": "3dot Scape: Discover Choices"
      },
      {
        "command": "threedot.scape.populateChoice",
        "title": "3dot Scape: Populate Choice"
      },
      {
        "command": "threedot.scape.discoverQualify",
        "title": "3dot Scape: Discover Qualify"
      },
      {
        "command": "threedot.scape.qualifyChoice",
        "title": "3dot Scape: Qualify Choice"
      },
      {
        "command": "threedot.scape.insertQualifiedCall",
        "title": "3dot Scape: Insert Qualified Call"
      },
      {
        "command": "threedot.contract.bindCapabilities",
        "title": "3dot Contract: Bind Capabilities"
      },
      {
        "command": "threedot.contract.openBindingMatrix",
        "title": "3dot Contract: Open Binding Matrix"
      },
      {
        "command": "threedot.contract.bindAtCursor",
        "title": "3dot Contract: Bind at Cursor"
      },
      {
        "command": "threedot.frontdoor.scaffold",
        "title": "3dot Front Door: Scaffold"
      },
      {
        "command": "threedot.frontdoor.preview",
        "title": "3dot Front Door: Preview"
      },
      {
        "command": "threedot.frontdoor.composeInteraction",
        "title": "3dot Front Door: Compose Interaction"
      },
      {
        "command": "threedot.frontdoor.verifySurface",
        "title": "3dot Front Door: Verify Surface"
      },
      {
        "command": "threedot.release.prepare",
        "title": "3dot Release: Prepare"
      },
      {
        "command": "threedot.release.openEvidence",
        "title": "3dot Release: Open Evidence"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "threedot.openCID",
          "when": "view == threedotCaps",
          "group": "navigation"
        },
        {
          "command": "threedot.reloadCID",
          "when": "view == threedotCaps",
          "group": "navigation"
        },
        {
          "command": "threedot.journey.openPanel",
          "when": "view == threedotCaps",
          "group": "navigation@2"
        },
        {
          "command": "threedot.journey.resume",
          "when": "view == threedotCaps && threedot.journey.active",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "threedot.insertCapability",
          "when": "resourceLangId == python || resourceLangId == typescript",
          "group": "1_modification@9"
        },
        {
          "command": "threedot.contract.bindAtCursor",
          "when": "threedot.journey.active && (resourceLangId == python || resourceLangId == typescript || resourceLangId == javascript)",
          "group": "1_modification@10"
        },
        {
          "command": "threedot.frontdoor.composeInteraction",
          "when": "threedot.journey.persona == javascript && threedot.journey.active",
          "group": "1_modification@11"
        }
      ],
      "commandPalette": [
        {
          "command": "threedot.journey.selectIntegration",
          "when": "threedot.journey.persona == rails"
        },
        {
          "command": "threedot.journey.defineOperations",
          "when": "threedot.journey.persona == rails"
        },
        {
          "command": "threedot.cpcp.planBoundary",
          "when": "threedot.journey.persona == rails"
        },
        {
          "command": "threedot.journey.defineInterfacePromise",
          "when": "threedot.journey.persona == javascript"
        },
        {
          "command": "threedot.frontdoor.scaffold",
          "when": "threedot.journey.persona == javascript"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "threedotCaps",
        "contents": "No CID operations yet.\n[Embed a starter CID](command:threedot.embedCID)\n[Start a Cyborg Journey](command:threedot.journey.start)\n\nType … in a Python file once a CID is present."
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "threedot",
          "title": "3dot",
          "icon": "media/threedot.svg"
        }
      ]
    },
    "views": {
      "threedot": [
        {
          "id": "threedotCaps",
          "name": "Cyborg Interface (CID)"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": ".threedot/cid.json",
        "url": "./schema/cid.schema.json"
      },
      {
        "fileMatch": ".threedot/journey.json",
        "url": "./schema/journey.schema.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "threedot-cpcp",
        "required": ["task"],
        "properties": {
          "task": {
            "type": "string",
            "description": "deploy | verify | run-pod",
            "enum": ["deploy", "verify", "run-pod"]
          }
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "threedot.cyborgJourney",
        "title": "Cyborg Journey",
        "description": "Guided CID-grounded developer spine: Mission → Experience → Engineering → Code. Pick Rails or JavaScript; the Journey panel is the authoritative process surface.",
        "steps": [
          {
            "id": "threedot.journey.entry",
            "title": "Start or resume your journey",
            "description": "Open the Journey panel, choose a persona, and persist state in ``.threedot/journey.json``.\n\n[Start Journey](command:threedot.journey.start)\n[Resume](command:threedot.journey.resume)\n[Open Panel](command:threedot.journey.openPanel)",
            "media": { "image": "media/threedot.svg", "altText": "3dot" },
            "completionEvents": ["onCommand:threedot.journey.start", "onCommand:threedot.journey.resume"]
          },
          {
            "id": "threedot.journey.mission",
            "title": "Mission altitude",
            "description": "Rails: capture integration intent. JavaScript: define the interface promise.\n\n[Rails Integration](command:threedot.journey.selectIntegration)\n[JS Interface Promise](command:threedot.journey.defineInterfacePromise)",
            "media": { "image": "media/threedot.svg", "altText": "Mission" },
            "completionEvents": ["onContext:threedot.journey.altitude == mission"]
          },
          {
            "id": "threedot.journey.experience",
            "title": "Experience altitude",
            "description": "Named operations (Rails) or front-door scaffold (JS) with never-raise envelopes.\n\n[Define Operations](command:threedot.journey.defineOperations)\n[Front Door Scaffold](command:threedot.frontdoor.scaffold)",
            "media": { "image": "media/threedot.svg", "altText": "Experience" }
          },
          {
            "id": "threedot.journey.engineering",
            "title": "Engineering altitude",
            "description": "Pod boundary / binding matrix + mmg-scape qualification.\n\n[Plan Boundary](command:threedot.cpcp.planBoundary)\n[Bind Capabilities](command:threedot.contract.bindCapabilities)\n[Discover Qualify](command:threedot.mmgScape.discoverQualify)",
            "media": { "image": "media/threedot.svg", "altText": "Engineering" }
          },
          {
            "id": "threedot.journey.code",
            "title": "Code altitude — reuse 3dot affordances",
            "description": "Type **…** or ``three.`` for CID completions. Embed CID, CodeLens, diagnostics, and the CID tree stay as-is; the journey drives them.\n\n[Generate Bind Run](command:threedot.cpcp.generateBindRun)\n[Compose Interaction](command:threedot.frontdoor.composeInteraction)\n[Embed CID](command:threedot.embedCID)",
            "media": { "image": "media/threedot.svg", "altText": "Code" }
          },
          {
            "id": "threedot.journey.release",
            "title": "Release with evidence",
            "description": "Deploy / verify tasks and open release evidence. Gates block release without proof.\n\n[Prepare Release](command:threedot.release.prepare)\n[Verify](command:threedot.cpcp.verify)\n[Open Evidence](command:threedot.release.openEvidence)",
            "media": { "image": "media/threedot.svg", "altText": "Release" }
          }
        ]
      }
    ],
    "configuration": {
      "title": "3dot",
      "properties": {
        "threedot.autoImport": {
          "type": "boolean",
          "default": true,
          "description": "Insert `import three` when completing a Python capability that needs it."
        },
        "threedot.callLabels": {
          "type": "string",
          "enum": ["endOfLine", "inlay", "codelens", "both", "off"],
          "default": "endOfLine",
          "description": "Where to show `3dot · role → Shape` on three.* calls. Cursor often does not draw CodeLens; endOfLine puts the label after the call."
        },
        "threedot.journey.autoOpenPanel": {
          "type": "boolean",
          "default": true,
          "description": "Open the Journey webview when a persona is selected."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test:parse": "npm run compile && node scripts/check-parse.js",
    "check:commands": "node scripts/check-commands.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/laquereric/threedot-vscode"
  },
  "keywords": [
    "cyborg",
    "threedot",
    "json-rpc-ld",
    "lsp",
    "agent",
    "journey",
    "cpcp"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  }
}
