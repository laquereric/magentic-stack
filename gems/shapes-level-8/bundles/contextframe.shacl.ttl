# ContextFrame / Meaning / Clarification -- the sole inter-application
# boundary message (gap 107). CONTAINMENT, not three peers.
#
# A Meaning sits under a ContextFrame. A Clarification sits under a
# Meaning. Input is frame-independent and is not modelled here.
#
# Internal name ContextFrame: p8:FrameChange / frameName / frameDigest
# are a different Frame (how the team works). ux:PanelFrame is a UI
# kind. Do not reuse those names.
#
# Not profile-11: that is semantic GOVERNANCE (Concept, DefinitionRevision,
# Attestation). Do not extend profile-11-meaning.ttl.
#
# IRIs follow ADR 0060's live convention (https://w3id.org/cpcp/osi8/
# with a topic segment). This file does not publish a w3id.org redirect.
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix cf:   <https://w3id.org/cpcp/osi8/contextframe#> .

cf:ContextFrameShape a sh:NodeShape ;
  sh:targetClass cf:ContextFrame ;
  sh:property [
    sh:path cf:meaning ;
    sh:node cf:MeaningShape ;
    sh:message "a Meaning sits under a ContextFrame, not beside it" ] .

cf:MeaningShape a sh:NodeShape ;
  sh:targetClass cf:Meaning ;
  # AMENDED by MeaningActivations.md. maxCount 1 said a meaning belongs to
  # exactly one frame; it is ACTIVATED under frames, with a signed weight, and
  # may be activated under many. minCount 1 stays: a payload naming a meaning
  # must name at least one activation, or the meaning is unanchored.
  sh:property [
    sh:path cf:frameActivation ;
    sh:minCount 1 ;
    sh:node cf:FrameActivationShape ;
    sh:message "a Meaning names at least one ContextFrame activation" ] ;
  sh:property [
    sh:path cf:clarification ;
    sh:node cf:ClarificationShape ;
    sh:message "a Clarification sits under a Meaning, not beside it" ] .

cf:ClarificationShape a sh:NodeShape ;
  sh:targetClass cf:Clarification ;
  sh:property [
    sh:path cf:meaningActivation ;
    sh:minCount 1 ;
    sh:node cf:MeaningActivationShape ;
    sh:message "a Clarification names at least one Meaning activation" ] .

# The activation itself: which node, and how strongly. Weight is closed
# [-1, +1] and numeric -- not an enum and not a boolean, because sign is
# first-class. Absence of an activation is not weight 0: zero means the pair is
# in the model and contributes nothing, which is a different claim from never
# having been considered.
cf:FrameActivationShape a sh:NodeShape ;
  sh:property [
    sh:path cf:frame ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class cf:ContextFrame ;
    sh:message "an activation names exactly one ContextFrame" ] ;
  sh:property [
    sh:path cf:weight ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:decimal ;
    sh:minInclusive -1 ; sh:maxInclusive 1 ;
    sh:message "weight is a decimal in [-1, +1]; out of range is a refusal, not a clamp" ] .

cf:MeaningActivationShape a sh:NodeShape ;
  sh:property [
    sh:path cf:meaning ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class cf:Meaning ;
    sh:message "an activation names exactly one Meaning" ] ;
  sh:property [
    sh:path cf:weight ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:decimal ;
    sh:minInclusive -1 ; sh:maxInclusive 1 ;
    sh:message "weight is a decimal in [-1, +1]; out of range is a refusal, not a clamp" ] .
