  p5:outcome "applied" ; p5:version "1" ;
  p5:time "2026-08-18T10:00:00Z"^^xsd:dateTime ;
  p5:causalParentRef <urn:osi:level-8:causal-root> .

<https://example.test/journal/1> a p5:Journal ;
