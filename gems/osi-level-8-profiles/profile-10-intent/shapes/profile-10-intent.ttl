# A grounding that is missing any of its five references is not a partial
# grounding, it is an ungrounded Effect wearing the word. All five are
# required. private_local is excluded: a grounding nobody else can see
# cannot ground a boundary crossing.
int:IntentGroundingShape a sh:NodeShape ;
  sh:targetClass int:IntentGrounding ; sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [ sh:path int:cid ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:profileId ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "osi-level-8/profile-10" ) ] ;
  sh:property [ sh:path int:ledgerPlacement ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "canonical" "sync_intent" ) ] ;
  sh:property [ sh:path int:digest ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^sha256:" ] ;
  sh:property [ sh:path int:state ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:created ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:wasGeneratedBy ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:provenanceActorCid ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:provenanceSourceCid ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:journeyCid ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:missionCid ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:personaCid ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:goalCid ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:valuePropositionCid ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:validFrom ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:validUntil ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:status ; sh:maxCount 1 ; sh:datatype xsd:string ] .

# The trace is what TraceGate writes on commit. traceStatus is closed to
# "committed" because a trace in any other state would let an Effect land
# while claiming an intent link it does not have.
int:IntentTraceShape a sh:NodeShape ;
  sh:targetClass int:IntentTrace ; sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [ sh:path int:cid ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:profileId ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "osi-level-8/profile-10" ) ] ;
  sh:property [ sh:path int:ledgerPlacement ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "canonical" "sync_intent" "private_local" ) ] ;
  sh:property [ sh:path int:digest ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^sha256:" ] ;
  sh:property [ sh:path int:state ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:created ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:wasGeneratedBy ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:provenanceActorCid ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:provenanceSourceCid ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:effectCid ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:groundingCid ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:traceStatus ; sh:maxCount 1 ; sh:in ( "committed" ) ] ;
  sh:property [ sh:path int:tracedAt ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:missionCid ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:personaCid ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:goalCid ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:valuePropositionCid ; sh:maxCount 1 ; sh:datatype xsd:string ] .
