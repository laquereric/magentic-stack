# OSI Level 8 - Profile 10 (INTENT) shapes.
#
# WHY THIS FILE EXISTS. P10 was the one profile with an implementation and no
# shapes: its contract lived only as a Ruby allowlist in
# rails_osi_level_8/intent/validator.rb, whose own comment described it as a
# "Ruby allowlist over compiled SHACL vocab" -- over a SHACL vocabulary that was
# never written. So P10 was invisible to Gate 2, and its closed-shape claim was
# enforced by code rather than by a contract the code is checked against.
#
# Per ADR 0009 the shapes are authoritative and code derives from them. The Ruby
# allowlist is kept in step by scripts/check_p10_alignment.py, which fails Gate 2
# on any divergence -- otherwise this file would simply be a second copy, drifting
# at its own rate, which is the failure ADR 0014 is about.
#
# Closed by construction: an unknown predicate is REFUSED, not preserved.
# @id is the node IRI and @type is rdf:type, so neither appears as a property.

@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix int:  <https://w3id.org/cpcp/osi8/intent#> .

# --- shared -----------------------------------------------------------------
# Every P10 node carries these. cid and digest are the identity pair: the digest
# is over intrinsic content, the cid over (class, id, digest), so re-deriving an
# identity differently is not possible.

int:MissionShape a sh:NodeShape ;
  sh:targetClass int:Mission ; sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [ sh:path int:cid ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:profileId ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "osi-level-8/profile-10" ) ] ;
  sh:property [ sh:path int:ledgerPlacement ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:in ( "canonical" "sync_intent" "private_local" ) ] ;
  sh:property [ sh:path int:digest ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:datatype xsd:string ; sh:pattern "^sha256:" ] ;
  sh:property [ sh:path int:state ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:created ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:wasGeneratedBy ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:provenanceActorCid ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:provenanceSourceCid ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:title ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:purposeStatement ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:ratificationStatus ; sh:maxCount 1 ; sh:datatype xsd:string ] .

int:VisionShape a sh:NodeShape ;
  sh:targetClass int:Vision ; sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [ sh:path int:cid ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:profileId ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "osi-level-8/profile-10" ) ] ;
  sh:property [ sh:path int:ledgerPlacement ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:in ( "canonical" "sync_intent" "private_local" ) ] ;
  sh:property [ sh:path int:digest ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:datatype xsd:string ; sh:pattern "^sha256:" ] ;
  sh:property [ sh:path int:state ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:created ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:wasGeneratedBy ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:provenanceActorCid ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path int:provenanceSourceCid ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
