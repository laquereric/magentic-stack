# OSI Level 8 — Profile 6: Enterprise Authorization Evidence
# CLOSED SHACL NodeShapes (base §8 conventions).
@prefix p6:  <https://w3id.org/laquereric/osi-level-8/profile-6/v1#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .


p6:Principal a rdfs:Class .
p6:Delegate a rdfs:Class .
p6:CredentialRef a rdfs:Class .
p6:PolicyRef a rdfs:Class .
p6:AuthorizationDecision a rdfs:Class .
p6:Consent a rdfs:Class .
p6:Revocation a rdfs:Class .

p6:PrincipalShape a sh:NodeShape ;
  sh:targetClass p6:Principal ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p6:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-6/enterprise-authorization-evidence/v1> ;
  ] ;
  sh:property [
    sh:path p6:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p6:principalKind ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "human" "organization" "service" "cyborg" ) ;
  ] ;
  sh:property [ sh:path p6:displayRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [
    sh:path p6:status ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "active" "suspended" "revoked" ) ;
  ] .

p6:DelegateShape a sh:NodeShape ;
  sh:targetClass p6:Delegate ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p6:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-6/enterprise-authorization-evidence/v1> ;
  ] ;
  sh:property [
    sh:path p6:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [ sh:path p6:delegatorRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p6:delegateeRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p6:scopeRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p6:validFrom ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p6:validUntil ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p6:delegationBasisRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [
    sh:path p6:status ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "active" "expired" "revoked" ) ;
  ] .

p6:CredentialRefShape a sh:NodeShape ;
  sh:targetClass p6:CredentialRef ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p6:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-6/enterprise-authorization-evidence/v1> ;
  ] ;
  sh:property [
    sh:path p6:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [ sh:path p6:principalRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [
    sh:path p6:credentialLocator ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:message "CredentialRef.credentialLocator MUST be an IRI reference, NEVER a literal secret" ;
  ] ;
  sh:property [ sh:path p6:credentialKind ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p6:verificationMethodRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [
    sh:path p6:status ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "active" "expired" "revoked" ) ;
  ] .

p6:PolicyRefShape a sh:NodeShape ;
  sh:targetClass p6:PolicyRef ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p6:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-6/enterprise-authorization-evidence/v1> ;
  ] ;
  sh:property [
    sh:path p6:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [ sh:path p6:policyId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p6:policyVersion ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ] ;
  sh:property [ sh:path p6:policyDigest ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^sha256:[0-9a-fA-F]{64}$" ] ;
  sh:property [ sh:path p6:publisherRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p6:effectiveFrom ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] .

p6:AuthorizationDecisionShape a sh:NodeShape ;
  sh:targetClass p6:AuthorizationDecision ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p6:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-6/enterprise-authorization-evidence/v1> ;
  ] ;
  sh:property [
    sh:path p6:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [ sh:path p6:subjectRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p6:action ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p6:resourceRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [
    sh:path p6:decision ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "permit" "deny" "allow" "conditional" ) ;
  ] ;
  sh:property [ sh:path p6:policyRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p6:policyDigest ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^sha256:[0-9a-fA-F]{64}$" ] ;
  sh:property [ sh:path p6:evidenceRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ] ;
  sh:property [ sh:path p6:decidedAt ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p6:validUntil ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] .

p6:ConsentShape a sh:NodeShape ;
  sh:targetClass p6:Consent ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p6:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-6/enterprise-authorization-evidence/v1> ;
  ] ;
  sh:property [
    sh:path p6:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [ sh:path p6:grantorRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p6:purpose ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p6:scopeRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [
    sh:path p6:status ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "active" "expired" "revoked" ) ;
  ] ;
  sh:property [ sh:path p6:grantedAt ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p6:validUntil ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] .

p6:RevocationShape a sh:NodeShape ;
  sh:targetClass p6:Revocation ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p6:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-6/enterprise-authorization-evidence/v1> ;
  ] ;
  sh:property [
    sh:path p6:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [ sh:path p6:targetRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p6:revokedByRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p6:reason ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p6:effectiveAt ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p6:revokedAt ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p6:scopeRef ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] .
