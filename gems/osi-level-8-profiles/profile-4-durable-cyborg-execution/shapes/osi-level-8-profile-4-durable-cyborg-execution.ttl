# OSI Level 8 — Profile 4: Durable Cyborg Execution
# CLOSED SHACL NodeShapes (base §8 conventions).
@prefix p4:  <https://w3id.org/laquereric/osi-level-8/profile-4/v1#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .


p4:DurableRun a rdfs:Class .
p4:Checkpoint a rdfs:Class .
p4:RetryPlan a rdfs:Class .
p4:CompensationPlan a rdfs:Class .
p4:TerminalReceipt a rdfs:Class .

p4:DurableRunShape a sh:NodeShape ;
  sh:targetClass p4:DurableRun ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p4:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-4/durable-cyborg-execution/v1> ;
  ] ;
  sh:property [
    sh:path p4:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [ sh:path p4:runId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ] ;
  sh:property [ sh:path p4:operationId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ] ;
  sh:property [
    sh:path p4:status ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "requested" "active" "suspended" "retrying" "compensating" "succeeded" "failed" "compensated" "cancelled" ) ;
  ] ;
  sh:property [ sh:path p4:cyborgRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p4:requestedAt ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p4:checkpointRef ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path p4:runInputDigest ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^sha256:[0-9a-fA-F]{64}$" ] ;
  sh:property [ sh:path p4:stateDigest ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^sha256:[0-9a-fA-F]{64}$" ] .

p4:CheckpointShape a sh:NodeShape ;
  sh:targetClass p4:Checkpoint ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p4:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-4/durable-cyborg-execution/v1> ;
  ] ;
  sh:property [
    sh:path p4:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [ sh:path p4:runRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p4:stepId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p4:sequence ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p4:stateDigest ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^sha256:[0-9a-fA-F]{64}$" ] ;
  sh:property [ sh:path p4:resumeTokenRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p4:createdAt ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p4:preconditionDigest ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:pattern "^sha256:[0-9a-fA-F]{64}$" ] .

p4:RetryPlanShape a sh:NodeShape ;
  sh:targetClass p4:RetryPlan ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p4:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-4/durable-cyborg-execution/v1> ;
  ] ;
  sh:property [
    sh:path p4:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [ sh:path p4:runRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p4:targetRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p4:maxAttempts ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
  sh:property [ sh:path p4:backoffRule ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p4:idempotencyKey ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p4:retryableReason ; sh:datatype xsd:string ; sh:minCount 1 ] .

p4:CompensationPlanShape a sh:NodeShape ;
  sh:targetClass p4:CompensationPlan ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p4:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-4/durable-cyborg-execution/v1> ;
  ] ;
  sh:property [
    sh:path p4:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [ sh:path p4:runRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p4:compensatesEffectRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p4:compensationEffectRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p4:preconditionDigest ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^sha256:[0-9a-fA-F]{64}$" ] .

p4:TerminalReceiptShape a sh:NodeShape ;
  sh:targetClass p4:TerminalReceipt ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p4:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-4/durable-cyborg-execution/v1> ;
  ] ;
  sh:property [
    sh:path p4:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [ sh:path p4:runRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p4:operationId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [
    sh:path p4:outcome ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "succeeded" "failed" "compensated" "cancelled" ) ;
  ] ;
  sh:property [ sh:path p4:finalStateDigest ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^sha256:[0-9a-fA-F]{64}$" ] ;
  sh:property [ sh:path p4:completedAt ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p4:signerRef ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path p4:signature ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 8 ] ;
  sh:property [ sh:path p4:attestationRef ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] .
