# VALID Profile 3 instance graph — should CONFORM
@prefix p3:  <https://w3id.org/laquereric/osi-level-8/profile-3/v1#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.test/req/1> a p3:RouteRequest ;
  p3:shapeId <https://w3id.org/laquereric/osi-level-8/shapes/profile-3/switchyard/v1> ;
  p3:contextId <https://w3id.org/laquereric/osi-level-8/profile-3/v1> ;
  p3:operationId "urn:op:4a7e" ;
  p3:capability <urn:capability:text-generation> ;
  p3:privacyClass "restricted" ;
  p3:routePolicy <urn:policy:consumer-default-v3> ;
  p3:payloadRef <urn:private-local:payload:1c2f> .

<https://example.test/cand/1> a p3:RouteCandidate ;
  p3:shapeId <https://w3id.org/laquereric/osi-level-8/shapes/profile-3/switchyard/v1> ;
  p3:contextId <https://w3id.org/laquereric/osi-level-8/profile-3/v1> ;
  p3:candidateClass "local" ;
  p3:capabilityRef <urn:capability:text-generation> ;
  p3:destinationRef <urn:dest:local-mlx> ;
  p3:eligibility "eligible" .

<https://example.test/dec/1> a p3:RouteDecision ;
  p3:shapeId <https://w3id.org/laquereric/osi-level-8/shapes/profile-3/switchyard/v1> ;
  p3:contextId <https://w3id.org/laquereric/osi-level-8/profile-3/v1> ;
  p3:routeRequestRef <https://example.test/req/1> ;
  p3:selectedCandidateRef <https://example.test/cand/1> ;
  p3:outcome "selected" ;
  p3:rationaleCode "POLICY_MATCH" ;
  p3:audit "eval-digest:abc" ;
  p3:policyDigest "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" .

<https://example.test/sy/1> a p3:SwitchYard ;
  p3:shapeId <https://w3id.org/laquereric/osi-level-8/shapes/profile-3/switchyard/v1> ;
  p3:contextId <https://w3id.org/laquereric/osi-level-8/profile-3/v1> ;
  p3:implementationRef <urn:impl:switchyard-offline-v1> ;
  p3:policyEvaluatorRef <urn:eval:policy-v3> ;
  p3:conformance "profile-3/v1" .

<https://example.test/metric/1> a p3:UsageMetric ;
  p3:shapeId <https://w3id.org/laquereric/osi-level-8/shapes/profile-3/switchyard/v1> ;
  p3:contextId <https://w3id.org/laquereric/osi-level-8/profile-3/v1> ;
  p3:metricWindow "PT1H" ;
  p3:routeClass "local" ;
  p3:measurement 42.0 ;
  p3:privacyTransform "aggregate-count-no-content" .

<https://example.test/offer/1> a p3:ProviderOffer ;
  p3:shapeId <https://w3id.org/laquereric/osi-level-8/shapes/profile-3/switchyard/v1> ;
  p3:contextId <https://w3id.org/laquereric/osi-level-8/profile-3/v1> ;
  p3:providerRef <urn:provider:acme> ;
  p3:capability <urn:capability:text-generation> ;
  p3:serviceTerms <urn:terms:acme-v1> ;
  p3:attestation <urn:attestation:acme-sig-1> ;
  p3:offerVersion "2026.08.01" .

<https://example.test/mm/1> a p3:MagenticMarket ;
  p3:shapeId <https://w3id.org/laquereric/osi-level-8/shapes/profile-3/switchyard/v1> ;
  p3:contextId <https://w3id.org/laquereric/osi-level-8/profile-3/v1> ;
  p3:marketRulesRef <urn:mm:rules/v1> ;
  p3:signalMethodRef <urn:mm:signal/v1> ;
  p3:verificationPolicyRef <urn:mm:verify/v1> .
