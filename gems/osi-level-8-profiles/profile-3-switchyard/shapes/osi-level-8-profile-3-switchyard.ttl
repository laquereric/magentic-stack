# OSI Level 8 — Profile 3: SwitchYard (Market Routing)
# CLOSED SHACL NodeShapes (base §8 conventions).
# Spec: docs/osi-level-8-profile-3-switchyard.md §2
# Design principle: SwitchYard may RECOMMEND a destination; it never creates
# authority to disclose. RouteDecision is an egress PROPOSAL, not a release.
@prefix p3:  <https://w3id.org/laquereric/osi-level-8/profile-3/v1#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

##############################################################################
# Classes
##############################################################################
p3:RouteRequest a rdfs:Class .
p3:RouteCandidate a rdfs:Class .
p3:RouteDecision a rdfs:Class .
p3:SwitchYard a rdfs:Class .
p3:UsageMetric a rdfs:Class .
p3:ProviderOffer a rdfs:Class .
p3:MagenticMarket a rdfs:Class .

##############################################################################
# RouteRequest — payloadRef is IRI (private_local); never inline payload
##############################################################################
p3:RouteRequestShape a sh:NodeShape ;
  sh:targetClass p3:RouteRequest ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p3:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-3/switchyard/v1> ;
  ] ;
  sh:property [
    sh:path p3:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p3:operationId ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:minLength 1 ;
  ] ;
  sh:property [
    sh:path p3:capability ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p3:privacyClass ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "public" "internal" "restricted" "secret" ) ;
  ] ;
  sh:property [
    sh:path p3:routePolicy ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p3:payloadRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:message "payloadRef MUST be an IRI reference (private_local); never an inline payload literal" ;
  ] .

##############################################################################
# RouteCandidate
##############################################################################
p3:RouteCandidateShape a sh:NodeShape ;
  sh:targetClass p3:RouteCandidate ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p3:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-3/switchyard/v1> ;
  ] ;
  sh:property [
    sh:path p3:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p3:candidateClass ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "local" "direct_api" "marketplace" "api" ) ;
  ] ;
  sh:property [
    sh:path p3:capabilityRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p3:destinationRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p3:eligibility ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] .

##############################################################################
# RouteDecision — egress PROPOSAL only (closed: no payload/prompt/embedding/telemetry)
##############################################################################
p3:RouteDecisionShape a sh:NodeShape ;
  sh:targetClass p3:RouteDecision ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p3:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-3/switchyard/v1> ;
  ] ;
  sh:property [
    sh:path p3:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p3:routeRequestRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p3:selectedCandidateRef ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p3:outcome ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "selected" "blocked" "no-route" ) ;
  ] ;
  sh:property [
    sh:path p3:rationaleCode ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path p3:audit ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p3:policyDigest ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:pattern "^sha256:[0-9a-fA-F]{64}$" ;
    sh:message "RouteDecision MUST carry policyDigest (decision references policy; does not authorize egress)" ;
  ] .
  # NOTE: payload / prompt / embedding / rawTelemetry are intentionally NOT
  # declared. sh:closed true rejects them — canonical decision is minimized.

##############################################################################
# SwitchYard
##############################################################################
p3:SwitchYardShape a sh:NodeShape ;
  sh:targetClass p3:SwitchYard ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p3:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-3/switchyard/v1> ;
  ] ;
  sh:property [
    sh:path p3:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p3:implementationRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p3:policyEvaluatorRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p3:conformance ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] .

##############################################################################
# UsageMetric — content-free, consented, aggregate
##############################################################################
p3:UsageMetricShape a sh:NodeShape ;
  sh:targetClass p3:UsageMetric ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p3:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-3/switchyard/v1> ;
  ] ;
  sh:property [
    sh:path p3:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p3:metricWindow ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p3:routeClass ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "local" "direct_api" "marketplace" "api" ) ;
  ] ;
  sh:property [
    sh:path p3:measurement ;
    sh:datatype xsd:decimal ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p3:privacyTransform ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:message "UsageMetric MUST declare privacyTransform (content-free, consented, aggregate)" ;
  ] .

##############################################################################
# ProviderOffer — signed/typed offer
##############################################################################
p3:ProviderOfferShape a sh:NodeShape ;
  sh:targetClass p3:ProviderOffer ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p3:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-3/switchyard/v1> ;
  ] ;
  sh:property [
    sh:path p3:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p3:providerRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p3:capability ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p3:serviceTerms ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p3:attestation ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:message "ProviderOffer MUST include attestations (signed/typed offer)" ;
  ] ;
  sh:property [
    sh:path p3:offerVersion ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:minLength 1 ;
  ] .

##############################################################################
# MagenticMarket
##############################################################################
p3:MagenticMarketShape a sh:NodeShape ;
  sh:targetClass p3:MagenticMarket ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p3:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-3/switchyard/v1> ;
  ] ;
  sh:property [
    sh:path p3:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p3:marketRulesRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p3:signalMethodRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p3:verificationPolicyRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] .
