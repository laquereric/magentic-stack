# OSI Level 8 — Profile 8: Architectural Learning Loop
# CLOSED SHACL NodeShapes (base §8 conventions).
# Spec: docs/osi-level-8-profile-8-architectural-learning-loop.md §§2–3
@prefix p8:  <https://w3id.org/laquereric/osi-level-8/profile-8/v1#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

##############################################################################
# Classes
##############################################################################
p8:SharedCognitionModel a rdfs:Class .
p8:AssumptionRecord a rdfs:Class .
p8:DriftMeasurement a rdfs:Class .
p8:ReconciliationRun a rdfs:Class .
p8:ArchitectureModel a rdfs:Class .
p8:ArchitecturalDecisionRecord a rdfs:Class .
p8:FrameChange a rdfs:Class .
p8:AbsorptionOwnership a rdfs:Class .

##############################################################################
# SharedCognitionModel
##############################################################################
p8:SharedCognitionModelShape a sh:NodeShape ;
  sh:targetClass p8:SharedCognitionModel ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p8:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-8/architectural-learning-loop/v1> ;
  ] ;
  sh:property [
    sh:path p8:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:workUnitRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:humanHeldRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:agentHeldRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:specRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:coverage ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:ownerRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:version ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] .

##############################################################################
# AssumptionRecord — digests NOT raw values; status enum
##############################################################################
p8:AssumptionRecordShape a sh:NodeShape ;
  sh:targetClass p8:AssumptionRecord ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p8:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-8/architectural-learning-loop/v1> ;
  ] ;
  sh:property [
    sh:path p8:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:workUnitRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:sourceEffectRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:assumedValueDigest ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:pattern "^sha256:[0-9a-fA-F]{64}$" ;
    sh:message "assumedValueDigest MUST be a digest, NOT a raw assumed value" ;
  ] ;
  sh:property [
    sh:path p8:specGapRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:status ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "surfaced" "confirmed" "corrected" "superseded" ) ;
  ] ;
  sh:property [
    sh:path p8:provenance ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "human" "agent" "service" "policy" "reconciled" ) ;
  ] ;
  sh:property [
    sh:path p8:surfacedAt ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:humanDecisionRef ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
  ] .

##############################################################################
# DriftMeasurement
##############################################################################
p8:DriftMeasurementShape a sh:NodeShape ;
  sh:targetClass p8:DriftMeasurement ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p8:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-8/architectural-learning-loop/v1> ;
  ] ;
  sh:property [
    sh:path p8:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:workUnitRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:specVersion ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:realityDigest ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:pattern "^sha256:[0-9a-fA-F]{64}$" ;
  ] ;
  sh:property [
    sh:path p8:driftScore ;
    sh:datatype xsd:decimal ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:threshold ;
    sh:datatype xsd:decimal ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:measurementMethodRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:measuredAt ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] .

##############################################################################
# ReconciliationRun — MUST humanCheckpointRef + operationId
##############################################################################
p8:ReconciliationRunShape a sh:NodeShape ;
  sh:targetClass p8:ReconciliationRun ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p8:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-8/architectural-learning-loop/v1> ;
  ] ;
  sh:property [
    sh:path p8:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:operationId ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:minLength 1 ;
  ] ;
  sh:property [
    sh:path p8:workUnitRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:observationsRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:proposedModelDeltaRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:humanCheckpointRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:message "ReconciliationRun MUST have exactly one humanCheckpointRef before commit" ;
  ] ;
  sh:property [
    sh:path p8:outcome ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "proposed" "committed" "rejected" ) ;
  ] ;
  sh:property [
    sh:path p8:receiptRef ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
  ] .

##############################################################################
# ArchitectureModel
##############################################################################
p8:ArchitectureModelShape a sh:NodeShape ;
  sh:targetClass p8:ArchitectureModel ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p8:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-8/architectural-learning-loop/v1> ;
  ] ;
  sh:property [
    sh:path p8:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:scopeRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:modelVersion ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:modelDigest ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:pattern "^sha256:[0-9a-fA-F]{64}$" ;
  ] ;
  sh:property [
    sh:path p8:specRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path p8:reconciledAt ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:provenance ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "human" "agent" "service" "policy" "reconciled" ) ;
  ] .

##############################################################################
# ArchitecturalDecisionRecord
##############################################################################
p8:ArchitecturalDecisionRecordShape a sh:NodeShape ;
  sh:targetClass p8:ArchitecturalDecisionRecord ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p8:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-8/architectural-learning-loop/v1> ;
  ] ;
  sh:property [
    sh:path p8:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:decisionId ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:scopeRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:decision ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:rationaleRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:alternativesRef ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:status ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "proposed" "accepted" "rejected" "superseded" ) ;
  ] ;
  sh:property [
    sh:path p8:provenance ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "human" "agent" "service" "policy" "reconciled" ) ;
  ] ;
  sh:property [
    sh:path p8:deciderRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] .

##############################################################################
# FrameChange
##############################################################################
p8:FrameChangeShape a sh:NodeShape ;
  sh:targetClass p8:FrameChange ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p8:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-8/architectural-learning-loop/v1> ;
  ] ;
  sh:property [
    sh:path p8:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:sourceRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:frameName ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:frameDigest ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:pattern "^sha256:[0-9a-fA-F]{64}$" ;
  ] ;
  sh:property [
    sh:path p8:observedAt ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:affectedDomainRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] .

##############################################################################
# AbsorptionOwnership — MUST ownerRef; decision enum
##############################################################################
p8:AbsorptionOwnershipShape a sh:NodeShape ;
  sh:targetClass p8:AbsorptionOwnership ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path p8:shapeId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:hasValue <https://w3id.org/laquereric/osi-level-8/shapes/profile-8/architectural-learning-loop/v1> ;
  ] ;
  sh:property [
    sh:path p8:contextId ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:frameChangeRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:ownerRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:message "AbsorptionOwnership MUST have a named ownerRef (accountable Cyborg)" ;
  ] ;
  sh:property [
    sh:path p8:decision ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "adopt" "skip" "defer" ) ;
  ] ;
  sh:property [
    sh:path p8:migrationPlanRef ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path p8:affectedUnitRef ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path p8:decidedAt ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] .
