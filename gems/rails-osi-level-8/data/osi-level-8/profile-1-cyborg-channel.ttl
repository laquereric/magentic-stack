# Stub closed shape for Milestone 1 (minimal Grounding check used in-process).
# Full SHACL via mm-shacl-reader to be wired when the reader is vendored into magentic-stack.
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix osi:  <https://osi.example/shapes/> .
@prefix cpcp: <https://w3id.org/laquereric/cpcp/ns#> .

osi:P1NoteCreateEffectShape a sh:NodeShape ;
  sh:closed true ;
  sh:property [
    sh:path cpcp:idempotencyKey ;
    sh:minCount 1 ;
  ] .
