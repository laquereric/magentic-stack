@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix acia: <urn:mm:vocab/acia#> .
@prefix aria: <urn:mm:vocab/aria#> .

acia:ButtonShape a sh:NodeShape ;
  sh:targetClass acia:Button ;
  sh:property [ sh:path aria:accessibleName ; sh:minCount 1 ; sh:datatype xsd:string ] .

acia:HeadingShape a sh:NodeShape ;
  sh:targetClass acia:Heading ;
  sh:property [ sh:path aria:accessibleName ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path aria:level ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 6 ] .

acia:TabListShape a sh:NodeShape ;
  sh:targetClass acia:TabList ;
  sh:property [ sh:path acia:hasChild ; sh:node acia:TabShape ; sh:minCount 1 ] .

# Phase B enforcing profile: selected is required (explicit true|false; absence fails).
acia:TabShape a sh:NodeShape ;
  sh:targetClass acia:Tab ;
  sh:property [ sh:path aria:controls ; sh:nodeKind sh:IRI ; sh:minCount 1 ] ;
  sh:property [ sh:path aria:selected ; sh:datatype xsd:boolean ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path acia:stateProfileVersion ; sh:datatype xsd:string ; sh:minCount 0 ; sh:maxCount 1 ] .

acia:ToggleShape a sh:NodeShape ;
  sh:targetClass acia:Toggle ;
  sh:xone (
    [ sh:property [ sh:path aria:pressed ; sh:minCount 1 ] ]
    [ sh:property [ sh:path aria:expanded ; sh:minCount 1 ] ]
  ) .

acia:StrictImageShape a sh:NodeShape ;
  sh:targetClass acia:Image ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [ sh:path aria:accessibleName ; sh:minCount 1 ; sh:datatype xsd:string ] .

# --- the five SLT dimensions -------------------------------------------------
#
# These stopped being strings, so the shape says so. Each dimension points at the
# IRI of a row in its own table; a literal here means something wrote a bare
# token again, which is exactly the regression the tables exist to prevent.
#
# Targets sal:AciaNode because every node carries that rdf:type, whereas the
# acia: role classes only cover the six mapped roles.
#
# NOT sh:closed -- a node legitimately carries many other properties. And no
# sh:minCount: most nodes have no SLT tuple at all, and requiring one would fail
# the majority of live nodes rather than describe them.
acia:SltDimensionsShape a sh:NodeShape ;
  sh:targetClass <urn:mm:vocab/sal#AciaNode> ;
  sh:property [ sh:path acia:semanticRole ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path acia:contentRole  ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path acia:layoutKind   ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path acia:layoutArity  ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path acia:behaviorKind ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .
