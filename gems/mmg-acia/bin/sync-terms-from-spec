#!/usr/bin/env ruby
# frozen_string_literal: true

# Generate db/seeds/acia_terms.yml from the Profile 9 normative shapes.
#
# The specification owns the types. This gem implements them, so its term list is
# DERIVED, never authored -- run this after the spec moves, commit the result,
# and bin/check-spec-conformance fails the build if the two ever disagree.
#
#   bin/sync-terms-from-spec ../osi-level-8-profiles

require "yaml"

root = ARGV[0] || File.expand_path("../../osi-level-8-profiles", __dir__)
ttl = Dir[File.join(root, "profile-9-*/shapes/*.ttl")].first
abort("FAIL: no Profile 9 shapes under #{root}") unless ttl && File.file?(ttl)

src = File.read(ttl, encoding: "UTF-8")

# sh:path ux:NAME ... sh:in ( ux:a ux:b ... )   -- the enumerations, in order.
# The spec writes an enumeration two ways: 11 as IRIs, sh:in ( ux:heading ... ),
# and 2 -- relation and overridePolicy -- as string literals, sh:in ( "none" ... ).
# Read both. An extractor that understood only the first silently produced an
# EMPTY list for those two rather than failing, which is how 7 terms went missing
# without any error at all.
enums = src.scan(/sh:path\s+ux:(\w+)[^\]]*?sh:in\s*\(([^)]*)\)/m).to_h do |name, body|
  [name, body.scan(/ux:(\w+)|"([^"]+)"/).map { |iri, lit| iri || lit }]
end
abort("FAIL: no sh:in enumerations found in #{ttl}") if enums.empty?

# FAIL CLOSED. An enumeration that parsed to nothing means the shape is written
# in a form this reader does not understand -- which is a reason to stop, not a
# reason to emit an empty vocabulary and let the seeds silently lose a type.
empty = enums.select { |_, v| v.empty? }.keys
abort("FAIL: #{empty.join(', ')} parsed to zero terms -- unrecognised sh:in form") if empty.any?

doc = {
  "vocabulary" => "https://w3id.org/cpcp/osi8/ux#",
  "source" => "osi-level-8-profiles/#{File.basename(File.dirname(File.dirname(ttl)))}/shapes/#{File.basename(ttl)}",
  "enumerations" => enums
}

out = File.expand_path("../db/seeds/acia_terms.yml", __dir__)
File.write(out, <<~HEAD + YAML.dump(doc).sub(/\A---\n/, ""))
  # GENERATED by bin/sync-terms-from-spec. Do not edit.
  #
  # The Profile 9 normative shapes specify these types; this gem implements them.
  # Editing here would make the implementation the authority, which is backwards --
  # change the spec and re-run the generator.
HEAD

total = enums.values.sum(&:size)
terms = enums.values.flatten.uniq.size
puts "wrote #{out}"
puts "  #{enums.size} enumerations, #{total} slots, #{terms} distinct terms"
