require "json"
require_relative "../lib/vv-android"

cmd, *rest = ARGV
case cmd
when "version"
  puts Vv::Android::VERSION
when "generate"
  spec, out = rest
  if spec.nil? || out.nil?
    warn "usage: vv-android generate SPEC.yml OUTDIR"
    exit 1
  end
  result = Vv::Android.generate(spec: spec, output_dir: out)
  puts JSON.pretty_generate(result)
  exit(result[:ok] ? 0 : 2)
else
  warn "usage: vv-android {version | generate SPEC.yml OUTDIR}"
  exit 1
end
