# Profile 4 -- Durable Cyborg Execution: the shapes the catalog pins.
#
# Replaces a Milestone-1 stub that declared one shape while the catalog named two,
# so P4::DurableReceiptShape cited an IRI absent from the document whose digest it
# pinned.
#
# P4 wraps the same note.create PUSH as P1, one profile up: P1 governs the channel
# envelope, P4 governs whether the effect is DURABLE -- named intent, replayable,
# and answered by a receipt. The request constraints are therefore the same, and
# RailsOsiLevel8::Grounding treats the two shapes identically, which is why they
# are written identically rather than one deferring to the other.
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix osi:  <https://osi.example/shapes/> .
@prefix cpcp: <https://w3id.org/cpcp/ns#> .
@prefix note: <https://osi.example/ns/level-8/profile-1/note#> .
@prefix p4:   <https://osi.example/ns/level-8/profile-4/execution#> .

osi:P4NoteCreateEffectShape a sh:NodeShape ;
  sh:closed true ;
  sh:property [
    sh:path cpcp:idempotencyKey ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:message "a durable effect must name its intent, or a retry is a second effect" ] ;
  sh:property [
    sh:path note:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ;
    sh:message "a note needs a title" ] ;
  sh:property [ sh:path note:body ; sh:maxCount 1 ] ;
  sh:property [
    sh:path note:ledgerPlacement ; sh:maxCount 0 ;
    sh:message "ledger placement is assigned by the server, never supplied" ] ;
  sh:property [ sh:path cpcp:operationId ; sh:maxCount 1 ] ;
  sh:property [ sh:path cpcp:idempotencyScope ; sh:maxCount 1 ] ;
  sh:property [ sh:path cpcp:callerIri ; sh:maxCount 1 ] .

# The receipt BACK returns once the effect is durable. Server-authored, so no
# client-supplied constraint applies and Grounding enforces none.
osi:P4DurableReceiptShape a sh:NodeShape ;
  sh:property [ sh:path p4:receiptCid ; sh:maxCount 1 ] ;
  sh:property [ sh:path p4:status ; sh:maxCount 1 ] ;
  sh:property [ sh:path p4:operationRequestCid ; sh:maxCount 1 ] .
