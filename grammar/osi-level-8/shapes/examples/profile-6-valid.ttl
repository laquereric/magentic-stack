  p6:policyDigest "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ;
  p6:evidenceRef <https://example.test/evidence/1> ;
  p6:decidedAt "2026-08-18T10:00:00Z"^^xsd:dateTime .

<https://example.test/cred/1> a p6:CredentialRef ;
  p6:shapeId <https://w3id.org/laquereric/osi-level-8/shapes/profile-6/enterprise-authorization-evidence/v1> ; p6:contextId <https://w3id.org/laquereric/osi-level-8/profile-6/v1> ;
