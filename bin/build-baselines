#!/bin/sh
# Build the pod's BASELINE images for a target platform.
#
# magentic-stack builds baselines; a consumer such as app-oriented-translation
# builds a thin image FROM one of them by digest, in its OWN repo. Nothing here
# may reference a consumer. See docs/plans/pod-to-vps.md.
#
# back is the same image as backjob (one image, roles selected by $ROLE). front
# is NO LONGER one of those roles: ADR 0072 made FRONT a Bun container with its
# own lineage, so front-base is built here too. graph is PULLED, never built --
# oxigraph is pinned upstream by index digest.
#
# Cross-building here rather than on the VPS is deliberate: that box has 3.8GiB
# and ten running containers, and a Rails bundle with native gems is the worst
# thing to put on it.
set -u
PLATFORM="${1:-linux/amd64}"
TAG="${2:-$(echo "$PLATFORM" | sed 's|.*/||')}"
R=$(cd "$(dirname "$0")/.." && pwd)
cd "$R" || exit 1

GRAPH="oxigraph/oxigraph@sha256:e68b3625743db4a4b18129a907ae36766f89bb6deeb8ab50d35685dbabe00b0e"
rc=0

build() {
  name=$1; ctx=$2; df=$3
  printf "=== %-10s building %s\n" "$name" "$PLATFORM"
  # Two tags: the platform one for clarity, and :latest so a consumer's FROM does
  # not have to know which architecture it is being built for.
  if docker buildx build --platform "$PLATFORM" -t "mind-pod-$name:$TAG" -t "mind-pod-$name:latest" -f "$ctx/$df" "$ctx" --load
  then printf "=== %-10s OK\n" "$name"
  else printf "=== %-10s FAILED\n" "$name"; rc=1
  fi
}

# Same build, but the caller names the full image reference. front-base does not
# take the mind-pod- prefix and is not tagged by platform: compose and
# runtimes/mind-pod/front/Dockerfile both consume the bare tag front-base:local,
# and that is the tag FLOOR-FRONT.json and .cpcp/deploy.json declare. Tagging it
# mind-pod-front-base:arm64 here would build the right bytes under a name
# nothing looks for -- which is the state this script was in before.
build_as() {
  ref=$1; ctx=$2; df=$3
  name=${ref%%:*}
  printf "=== %-10s building %s\n" "$name" "$PLATFORM"
  if docker buildx build --platform "$PLATFORM" -t "$ref" -f "$ctx/$df" "$ctx" --load
  then printf "=== %-10s OK\n" "$name"
  else printf "=== %-10s FAILED\n" "$name"; rc=1
  fi
}

# rails-base is the PLATFORM base: no app code, just a Ruby and a populated
# GEM_HOME. Every Rails consumer -- mind-pod back, magentic-market-ai-site, and
# each user-generated app -- builds FROM it. Built first because the others may
# come to depend on it.
build rails-base "$R" runtimes/rails-base/Dockerfile

# front-base is the PLATFORM Bun FRONT base (ADR 0072). Like rails-base it is a
# floor an overlay builds FROM -- runtimes/mind-pod/front is that overlay, and
# compose passes this tag as the FRONT_BASE build-arg. Built from the repo ROOT:
# the Dockerfile COPYs runtimes/front-base/package.json and runtimes/front-base/src,
# so runtimes/front-base is not a valid context and fails on every COPY.
build_as front-base:local "$R" runtimes/front-base/Dockerfile

# switch builds from the repo ROOT: it reuses the vendored SwitchYard.offline
# gate at gems/switchyard-offline/shared, which sits outside runtimes/switch.
build switch "$R" runtimes/switch/Dockerfile
build mind   "$R/runtimes/mind-pod/mind" Dockerfile
build back   "$R/runtimes/mind-pod/app"  Dockerfile

echo
echo "=== baseline images ($PLATFORM)"
# front-base is listed by its own reference, not mind-pod-<name>:$TAG.
for ref in "mind-pod-rails-base:$TAG" front-base:local "mind-pod-switch:$TAG" \
           "mind-pod-mind:$TAG" "mind-pod-back:$TAG"; do
  id=$(docker image inspect "$ref" --format "{{.Id}}" 2>/dev/null || echo -)
  os=$(docker image inspect "$ref" --format "{{.Os}}/{{.Architecture}}" 2>/dev/null || echo -)
  printf "  %-26s %-12s %s\n" "$ref" "$os" "$id"
done
printf "  %-26s %-12s %s\n" graph "(pulled)" "$GRAPH"

echo
echo "NOTE: those are LOCAL image ids, not portable digests. An id is assigned by"
echo "the daemon that built it, so it identifies this build on this host and"
echo "nothing else. A consumer pinning FROM <baseline> needs a digest that"
echo "survives leaving this machine -- see docs/plans/pod-to-vps.md."
exit $rc
