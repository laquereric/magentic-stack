#!/usr/bin/env bash
# Manage the mind-pod demo Docker containers (FRONT/BACK/BACKJOB).
set -euo pipefail
cd "$(dirname "$0")/.."

APP=runtimes/mind-pod/app
MIND=runtimes/mind-pod/mind
CF="-f extract/compose.yml"
PORT=13000
UI_PORT=13001

usage() {
  cat <<EOF
Usage: bin/docker-containers {prereq|up|down|status}

Commands:
  prereq  Check Docker prerequisites (non-zero exit if missing)
  up      Start the mind-pod demo containers (FRONT at :$PORT)
  down    Stop and remove containers + volumes
  status  Show running container status
  digests Emit the built image ids + pinned parents as JSON (Plane C input)

The demo runs 3 roles from ONE image, plus MIND, SWITCH and GRAPH:
  - FRONT:   web UI at http://localhost:$PORT (no DB)
  - BACK:    sole writer + /_cpcp seam
  - BACKJOB: async reconciler
  - MIND:    NOOA agent; reaches Effect only through BACK's /_cpcp
  - SWITCH:  LLM plane; set a provider key at http://localhost:$UI_PORT
  - GRAPH:   Oxigraph; an RDF projection of the Rails models, not the authority

No local model ships with the pod, so cognition needs a key and DOES egress.
Until a TOOL-CAPABLE source is configured, switch refuses with no_capable_model
and MIND logs mind_error each cycle -- it does not degrade to a fallback.

Requires: docker, docker compose
EOF
  exit 1
}

check_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "Error: docker not installed" >&2
    exit 1
  fi
  if ! docker info >/dev/null 2>&1; then
    echo "Error: docker daemon not running" >&2
    exit 1
  fi
  if [ ! -f "$APP/extract/compose.yml" ]; then
    echo "Error: $APP/extract/compose.yml not found" >&2
    exit 1
  fi
}

do_prereq() {
  # Check prerequisites without requiring compose.yml (for early bootstrap check)
  if ! command -v docker >/dev/null 2>&1; then
    echo "✗ docker not installed"
    echo
    echo "Install Docker Desktop: https://www.docker.com/products/docker-desktop"
    exit 1
  fi
  if ! docker info >/dev/null 2>&1; then
    echo "✗ docker daemon not running"
    echo
    echo "Start Docker Desktop and try again."
    exit 1
  fi
  echo "✓ docker is installed and running"
  return 0
}

do_up() {
  check_docker
  echo "Starting mind-pod demo containers..."
  
  # Vendor rails-cpcp into the app image, and NOOA into the MIND image.
  # The app image is a THIN LAYER on rails-base, so the base must exist before
  # compose builds anything. compose cannot express that ordering across a
  # Dockerfile FROM, so do it here.
  if ! docker image inspect mind-pod-rails-base:latest >/dev/null 2>&1; then
    echo "Building rails-base (the platform base image)..."
    "$(dirname "$0")/build-baselines" "$(docker version --format '{{.Server.Os}}/{{.Server.Arch}}')" >/dev/null || {
      echo "Error: rails-base build failed" >&2
      exit 1
    }
  fi

  if [ -f "$APP/bin/prepare" ]; then
    ( cd "$APP" && bash bin/prepare ) || {
      echo "Error: prepare step failed" >&2
      exit 1
    }
  fi
  if [ -f "$MIND/bin/prepare" ]; then
    ( cd "$MIND" && bash bin/prepare ) || {
      echo "Error: MIND prepare failed (is upstreams/nooa initialized?)" >&2
      exit 1
    }
  fi
  
  # Build and start containers
  ( cd "$APP" && docker compose $CF up -d --build ) || {
    echo "Error: docker compose up failed" >&2
    exit 1
  }
  
  # Wait for FRONT to be healthy
  echo -n "Waiting for FRONT (http://localhost:$PORT/up) "
  up=0
  for i in $(seq 1 90); do
    if curl -sf http://localhost:$PORT/up >/dev/null 2>&1; then
      up=1
      echo " ✓"
      break
    fi
    echo -n "."
    sleep 2
  done
  
  if [ "$up" = 0 ]; then
    echo " ✗"
    echo "Warning: FRONT did not respond on :$PORT (port busy? check logs)" >&2
    ( cd "$APP" && docker compose $CF logs --tail=20 )
    exit 1
  fi
  
  # Seed a note via CPCP boundary
  curl -sf -X POST http://localhost:$PORT/notes \
    --data 'title=Hello from docker-containers&body=written by FRONT through BACK /_cpcp' \
    >/dev/null 2>&1 || echo "Warning: seed note failed (ok if already exists)"
  
  echo
  echo "✅ Mind-pod demo is LIVE:"
  echo "   FRONT:  http://localhost:$PORT  (web page; not /_cpcp)"
  echo "   BACK:   http://localhost:13002/_cpcp (host seam; in-pod is http://back:3000)"
  echo "   BACKJOB: reconciler (background)"
  echo "   MIND:   NOOA agent proposing through /_cpcp"
  echo "   SWITCH: LLM sources -> http://localhost:$UI_PORT"
  echo "   GRAPH:  Oxigraph (projection of the Rails models; empty until wired)"
  echo
  echo "   NOTE: no local model ships with the pod. Until you set a key for a"
  echo "         TOOL-CAPABLE model in the SWITCH UI, switch refuses with"
  echo "         no_capable_model and MIND logs mind_error every cycle."
  echo "         Setting a key turns egress ON for the completion path."
  echo
  echo "Stop with: bin/docker-containers down"
}

do_down() {
  check_docker
  echo "Stopping mind-pod demo containers..."
  ( cd "$APP" && docker compose $CF down -v ) || {
    echo "Error: docker compose down failed" >&2
    exit 1
  }
  echo "✓ Containers stopped and removed (volumes deleted)"
}

do_status() {
  check_docker
  echo "Mind-pod demo container status:"
  echo
  ( cd "$APP" && docker compose $CF ps )
  echo
  if curl -sf http://localhost:$PORT/up >/dev/null 2>&1; then
    echo "✅ FRONT is responding at http://localhost:$PORT"
  else
    echo "⚠️  FRONT is not responding at http://localhost:$PORT"
  fi
}

# What the effect plane needs, and the reason this command exists.
#
# Pinning the FROM lines made the PARENTS deterministic. It does nothing for the
# images this repo BUILDS: `mind-pod:demo` is a tag, and a tag is a moving
# pointer. Its digest is only knowable after the build, so it cannot be pinned
# in a file -- it has to be CAPTURED.
#
# That capture is the input to a Plane C snapshot. A materialization whose
# identity is a tag is not a materialization: rebuild and the same name points
# at different bytes, and "roll back to :demo" means nothing. Image ID is the
# content address of what was actually built, and RepoDigests is what a registry
# would agree to -- empty here because nothing is pushed, and that absence is
# itself worth recording rather than hiding.
do_digests() {
  check_docker
  local imgs="mind-pod:demo mind-pod-mind:demo mind-pod-switch:demo"
  echo "{"
  echo "  \"capturedAt\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\","
  echo "  \"builtImages\": ["
  local first=1
  for i in $imgs; do
    local id rd
    id=$(docker image inspect --format '{{.Id}}' "$i" 2>/dev/null || true)
    rd=$(docker image inspect --format '{{if .RepoDigests}}{{index .RepoDigests 0}}{{end}}' "$i" 2>/dev/null || true)
    [ $first -eq 1 ] || echo ","
    first=0
    printf '    {"tag": "%s", "imageId": "%s", "repoDigest": "%s", "built": %s}' \
      "$i" "$id" "$rd" "$([ -n "$id" ] && echo true || echo false)"
  done
  echo
  echo "  ],"
  echo "  \"pinnedParents\": ["
  echo "    {\"ref\": \"ruby:3.3-slim\",    \"digest\": \"$(grep -h '^FROM ruby' "$APP/Dockerfile" | sed 's/.*@//')\"},"
  echo "    {\"ref\": \"python:3.12-slim\", \"digest\": \"$(grep -h '^FROM python' "$MIND/Dockerfile" | sed 's/.*@//')\"},"
  echo "    {\"ref\": \"node:20-slim\",     \"digest\": \"$(grep -h '^FROM node' runtimes/switch/Dockerfile | sed 's/.*@//')\"}"
  echo "  ]"
  echo "}"
}

case "${1:-}" in
  prereq) do_prereq ;;
  up)     do_up ;;
  down)   do_down ;;
  status) do_status ;;
  digests) do_digests ;;
  *)      usage ;;
esac
