#!/usr/bin/env python3
"""Drive local docker from .cpcp/deploy.json.

Compile and runtime protocol stay in .cpcp/package.json. This script
only answers local_deploy: the SHAs that must be on this daemon for the
overlay (or the mind-pod demo) to run.

Walk from cwd to find .cpcp/deploy.json, then compose. Overlay clone:

    git clone <overlay> && cd <overlay> && bin/docker-containers up
"""
from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any

DEPLOY_REL = Path(".cpcp") / "deploy.json"
KIND = "cpcp-deploy"
OCI = __import__("re").compile(r"\Asha256:[0-9a-f]{64}\Z")


def refuse(reason: str, because: str, **extra: Any) -> int:
    env = {"ok": False, "reason": reason, "because": because, **extra}
    print(json.dumps(env, indent=2), file=sys.stderr)
    return 1


def find_root(start: Path | None = None) -> Path | None:
    cur = (start or Path.cwd()).resolve()
    for candidate in [cur, *cur.parents]:
        if (candidate / DEPLOY_REL).is_file():
            return candidate
    script_repo = Path(__file__).resolve().parent.parent
    if (script_repo / DEPLOY_REL).is_file():
        return script_repo
    return None


def load_deploy(root: Path) -> dict[str, Any] | int:
    path = root / DEPLOY_REL
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        return refuse("not_indexed", f"could not read {path}: {exc}")
    if data.get("kind") != KIND:
        return refuse(
            "unsupported_kind",
            f"{path} kind is {data.get('kind')!r}, want {KIND}. "
            ".cpcp/package.json is compile/runtime protocol.",
        )
    images = (data.get("local_deploy") or {}).get("images") or {}
    if not images:
        return refuse("not_indexed", f"{path} has no local_deploy.images")
    for key, image in images.items():
        digest = (image or {}).get("digest", "")
        if not OCI.match(digest):
            if ":" in str(digest) and not str(digest).startswith("sha256:"):
                return refuse(
                    "tag_is_not_identity",
                    f"{key} digest is {digest!r}; a tag is not a pin",
                )
            return refuse("malformed_digest", f"{key} digest is {digest!r}")
    return data


def docker_ok() -> bool:
    if shutil.which("docker") is None:
        return False
    return subprocess.run(
        ["docker", "info"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False
    ).returncode == 0


def image_present(ref: str) -> bool:
    return subprocess.run(
        ["docker", "image", "inspect", ref, "--format", "{{.Id}}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    ).returncode == 0


def compose_cmd(root: Path, data: dict[str, Any]) -> tuple[list[str], Path]:
    compose = data.get("compose") or {}
    rel = compose.get("file")
    if not rel:
        return [], root
    chdir = compose.get("chdir")
    work = (root / chdir).resolve() if chdir else root
    path = root / rel
    cmd = ["docker", "compose", "-f", str(path)]
    project = compose.get("project")
    if project:
        cmd.extend(["-p", project])
    return cmd, work


def stack_root(overlay_root: Path, data: dict[str, Any]) -> Path | None:
    stack = data.get("stack") or {}
    if stack.get("self"):
        return overlay_root
    env_name = stack.get("env") or "MAGENTIC_STACK_ROOT"
    env = os.environ.get(env_name)
    if env and (Path(env) / "gems").is_dir():
        return Path(env)
    sibling = stack.get("sibling") or "../magentic-stack"
    cand = (overlay_root / sibling).resolve()
    if (cand / "gems").is_dir():
        return cand
    return None


def pull_image(image: dict[str, Any]) -> bool:
    index = image.get("index_digest")
    name = image.get("name") or ""
    if index is False or not index or not name:
        return False
    if not OCI.match(str(index)):
        return False
    ref = f"{name}@{index}"
    print(f"pulling {ref}")
    return subprocess.run(["docker", "pull", ref], check=False).returncode == 0


def build_floor(stack: Path, key: str, data: dict[str, Any], image: dict[str, Any]) -> bool:
    spec = ((data.get("stack") or {}).get("build") or {}).get(key)
    if not spec:
        return False
    dockerfile = stack / spec["dockerfile"]
    context = stack / spec.get("context", ".")
    tag = spec.get("tag") or image.get("tag_for_humans")
    if not tag:
        return False
    print(f"building {key} as {tag} from {dockerfile}")
    rc = subprocess.run(
        ["docker", "build", "-t", tag, "-f", str(dockerfile), str(context)],
        check=False,
    ).returncode
    return rc == 0


def ensure_images(root: Path, data: dict[str, Any]) -> int | None:
    images = (data.get("local_deploy") or {}).get("images") or {}
    stack = stack_root(root, data)
    missing = []
    for key, image in images.items():
        digest = image["digest"]
        tag = image.get("tag_for_humans") or ""
        if image_present(digest) or (tag and image_present(tag)):
            continue
        if pull_image(image):
            continue
        if image.get("index_digest") is False and stack and build_floor(stack, key, data, image):
            print(
                f"note: built {key} from magentic-stack; local bytes may not "
                f"equal declared {digest[:19]}. That is unpublished-FLOOR local-dev."
            )
            continue
        missing.append(
            {
                "key": key,
                "digest": digest,
                "index_digest": image.get("index_digest"),
                "because": (
                    f"{key} is unpublished (index_digest: false) and not on this daemon"
                    if image.get("index_digest") is False
                    else f"{key} {digest[:19]} is not on this daemon and could not be pulled"
                ),
            }
        )
    if not missing:
        return None
    extra = ""
    if any(m.get("index_digest") is False for m in missing) and stack is None:
        extra = (
            " Set MAGENTIC_STACK_ROOT to a magentic-stack checkout (or place it at "
            "../magentic-stack) so unpublished floors can be built."
        )
    return refuse(
        "undeployable",
        "; ".join(m["because"] for m in missing) + extra,
        missing=missing,
    )


def run_hooks(root: Path, data: dict[str, Any], name: str) -> int | None:
    for rel in (data.get("hooks") or {}).get(name) or []:
        path = root / rel
        if not path.is_file():
            # REFUSE, DO NOT WARN. This printed to stderr and carried on, so
            # .cpcp/deploy.json went on naming runtimes/mind-pod/app/bin/prepare
            # for three weeks after e215ea1 deleted it on purpose, and the only
            # sign was one line scrolling past during a docker build. A declared
            # hook that does not run means the image is built from inputs nobody
            # prepared -- the same verdict as a hook that exits non-zero, which
            # this function already refuses.
            return refuse(
                "undeployable",
                f"hook {rel} is declared in .cpcp/deploy.json but does not exist",
            )
        print(f"hook {name}: {rel}")
        rc = subprocess.run(["bash", str(path)], cwd=path.parent, check=False).returncode
        if rc != 0:
            return refuse("undeployable", f"hook {rel} exited {rc}")
    return None


def up_env(data: dict[str, Any]) -> dict[str, str]:
    env = os.environ.copy()
    mapping = data.get("up_env") or {}
    images = (data.get("local_deploy") or {}).get("images") or {}
    for image_key, var in mapping.items():
        image = images.get(image_key) or {}
        value = image.get("tag_for_humans") or image.get("digest")
        if value:
            env[var] = value
    return env


def wait_health(data: dict[str, Any], seconds: int = 180) -> bool:
    health = data.get("health") or {}
    url = health.get("url")
    if not url:
        return True
    deadline = time.time() + seconds
    sys.stdout.write(f"Waiting for {health.get('label', 'health')} ({url}) ")
    sys.stdout.flush()
    while time.time() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=2) as res:
                if 200 <= res.status < 300:
                    print(" ✓")
                    return True
        except (urllib.error.URLError, TimeoutError, OSError):
            pass
        sys.stdout.write(".")
        sys.stdout.flush()
        time.sleep(2)
    print(" ✗")
    return False


def do_prereq() -> int:
    if shutil.which("docker") is None:
        print("✗ docker not installed")
        print("Install Docker Desktop: https://www.docker.com/products/docker-desktop")
        return 1
    if not docker_ok():
        print("✗ docker daemon not running")
        print("Start Docker Desktop and try again.")
        return 1
    print("✓ docker is installed and running")
    return 0


def do_up(root: Path, data: dict[str, Any]) -> int:
    if not docker_ok():
        return refuse("unreachable", "docker is not installed or the daemon is not running")
    failed = ensure_images(root, data)
    if failed is not None:
        return failed
    failed = run_hooks(root, data, "before_up")
    if failed is not None:
        return failed
    cmd, work = compose_cmd(root, data)
    if not cmd:
        return refuse("not_indexed", "compose.file missing from deploy.json")
    print("compose up:", " ".join(cmd), "in", work)
    rc = subprocess.run(cmd + ["up", "-d", "--build"], cwd=work, env=up_env(data), check=False).returncode
    if rc != 0:
        return refuse("undeployable", "docker compose up failed")
    if not wait_health(data):
        subprocess.run(cmd + ["logs", "--tail=40"], cwd=work, check=False)
        return refuse("undeployable", f"{(data.get('health') or {}).get('url')} did not respond")
    print()
    print("✅ overlay is LIVE")
    for label, url in (data.get("urls") or {}).items():
        print(f"   {label}:  {url}")
    print()
    print("Stop with: bin/docker-containers down")
    return 0


def do_down(root: Path, data: dict[str, Any]) -> int:
    if not docker_ok():
        return refuse("unreachable", "docker is not installed or the daemon is not running")
    cmd, work = compose_cmd(root, data)
    rc = subprocess.run(cmd + ["down", "-v"], cwd=work, check=False).returncode
    if rc != 0:
        return refuse("undeployable", "docker compose down failed")
    print("✓ containers stopped and removed (volumes deleted)")
    return 0


def do_status(root: Path, data: dict[str, Any]) -> int:
    if not docker_ok():
        return refuse("unreachable", "docker is not installed or the daemon is not running")
    cmd, work = compose_cmd(root, data)
    subprocess.run(cmd + ["ps"], cwd=work, check=False)
    health = data.get("health") or {}
    url = health.get("url")
    if url:
        try:
            with urllib.request.urlopen(url, timeout=2) as res:
                ok = 200 <= res.status < 300
        except (urllib.error.URLError, TimeoutError, OSError):
            ok = False
        mark = "✅" if ok else "⚠️ "
        print(f"{mark} {health.get('label', 'health')} at {url}")
    return 0


def usage() -> int:
    print(
        "Usage: bin/docker-containers {prereq|up|down|status}\n"
        "\n"
        "Reads .cpcp/deploy.json from this repo (walk from cwd).\n"
        "Compile/runtime protocol is .cpcp/package.json; this command is local_deploy."
    )
    return 1


def main(argv: list[str]) -> int:
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "prereq":
        return do_prereq()
    if cmd not in {"up", "down", "status"}:
        return usage()
    root = find_root()
    if root is None:
        return refuse(
            "not_indexed",
            "no .cpcp/deploy.json from cwd upward. An overlay declares deploy SHAs there.",
        )
    data = load_deploy(root)
    if isinstance(data, int):
        return data
    print(f"deploy: {root / DEPLOY_REL}")
    if cmd == "up":
        return do_up(root, data)
    if cmd == "down":
        return do_down(root, data)
    return do_status(root, data)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
