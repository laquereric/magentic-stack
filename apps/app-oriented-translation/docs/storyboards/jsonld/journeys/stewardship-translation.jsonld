      "channel": "cid:channel:web",
      "page": "cid:page:c1-translation-select-source"
    },
    {
      "cid": "cid:touchpoint:c2-translation-compose-target",
      "@type": "c4:Touchpoint",
      "channel": "cid:channel:web",
      "page": "cid:page:c2-translation-compose-target"
    },
    {
      "cid": "cid:touchpoint:c3-translation-review",
      "@type": "c4:Touchpoint",
      "channel": "cid:channel:web",
      "page": "cid:page:c3-translation-review"
    },
    {
      "cid": "cid:touchpoint:c4-translation-issued",
