  "profileId": "osi-level-8/profile-9",
  "ledgerPlacement": "canonical",
  "primaryActor": "cid:actor:stewardship-decision-maker",
  "goal": "Express a held referent for a new audience without creating a second concept",
  "scenario": "Source is held, a scoped target is composed, reviewed within limits, and issued",
  "channel": "cid:channel:web",
  "status": "active",
  "phase": [
    {
      "ordinal": 1,
      "name": "select-source",
      "goal": "hold the referent before changing audience"
    },
    {
      "ordinal": 2,
      "name": "compose-target",
      "goal": "draft a scoped expression without creating a second concept"
    },
    {
      "ordinal": 3,
      "name": "review",
      "goal": "target review is a decision with limits"
    },
    {
      "ordinal": 4,
      "name": "issued",
      "goal": "issue a reviewed expression, not a new source truth"
    }
  ],
  "hasFlow": [
    "cid:flow:stewardship-translation"
  ],
  "touchpoint": [
    {
      "cid": "cid:touchpoint:c1-translation-select-source",
