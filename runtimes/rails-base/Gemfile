# THE PLATFORM GEMFILE.
#
# What this file offers is what the platform offers. A thin layer that sticks to
# these gems installs in seconds -- everything is already in GEM_HOME, and
# nothing native gets compiled. A layer that adds a gem pays for its own resolve
# and build, which is the cost of leaving the platform, not a bug.
#
# The set is the FULL STOCK RAILS 8 SURFACE, i.e. what `rails new` gives you,
# because a user-generated app is generated against exactly that.
source "https://rubygems.org"

gem "rails", "~> 8.1.3", ">= 8.1.3.1"

# JSON IS PINNED BELOW 3.0 BECAUSE RAILS 8.1.3.1 CANNOT CALL IT.
#
# ActiveSupport depends on "json" with NO version constraint, so bundler
# resolves the newest -- and activesupport-8.1.3.1's own decoding.rb:25 calls
#
#     ::JSON.parse(json, options)          # two positional arguments
#
# while json 3.0.0 declares
#
#     def parse(source, on_load: nil, object_class: nil, array_class: nil, **options)
#
# One positional. So ActiveSupport::JSON.decode raises ArgumentError, and with
# it ActiveRecord::Type::Json#deserialize -- every JSON column, on every app on
# this platform.
#
# It was not obvious from the symptom. It surfaced inside transaction rollback
# (restore_transaction_record_state re-casts attributes), so the ArgumentError
# replaced whatever error caused the rollback, and the CPCP adapter turned that
# into a bare processing_failed. Two of stewardshiptranslation.com's three seam
# operations refused with no stated cause for it.
#
# Here rather than in each app: an unconstrained transitive dependency drifts on
# whatever day rubygems ships the next major, and the base is what every app
# resolves against. Lift when a Rails release calls json 3 correctly.
gem "json", "< 3.0"

gem "propshaft"
gem "sqlite3", ">= 2.1"
gem "puma", ">= 5.0"
gem "importmap-rails"
gem "turbo-rails"
gem "stimulus-rails"
gem "jbuilder"
gem "bcrypt", "~> 3.1.7"
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Database-backed adapters for Rails.cache, Active Job and Action Cable.
gem "solid_cache"
gem "solid_queue"
gem "solid_cable"

gem "bootsnap", require: false
gem "thruster", require: false
gem "image_processing", "~> 1.2"

# The platform's own interfaces. NOT path: and NOT git: -- they are built from
# gems/ and `gem install`ed into GEM_HOME by the Dockerfile, so a consuming
# app writes `gem "rails-cpcp"` with no path, no git ref, and no GitHub access at
# build time. Removing that cross-repo build dependency is most of the point.
#   rails-cpcp         the /_cpcp seam
#   rails-osi-level-8  Profile 9 ACIA
#   vv-html-components the component runtime those renders need to hydrate
#   mmg-semantic-editor the ACIA-tree editor: canonical ids in, several
#                       simultaneous edits out, with a code-diff default view
#   vv-graph            RDF projection of the AR models -- every node is a
#                       (model class, primary key), so the graph is a
#                       PROJECTION and the relational store is the authority
#   vv-blob             content-addressed blob storage in SQLite; the digest
#                       is the key, so a name cannot drift from what it names
#   mmg-blob            that store at the CPCP seam: blob.put/get/stat/
#                       entries/list, so a slice and an LLM reach ONE store
#   vv-base             the canonical homes shared across profiles --
#                       Actor, Persona, Journey, Flow, Mission, Vision --
#                       namespaced, so the next app can still have its own
#   mmg-graph           the graph at the CPCP seam: graph.query/count/
#                       entries/publish. The write CREATES its grounding
#                       entry, so an ungrounded node is inexpressible
#   vv-code-repo        procedure catalog contract + CPCP procedure.*
#   vv-self-learn       GOLD→PROD→Bronze→recommend; learn.*
#   vv-orinth           v2 Ornith envelopes + GRPO (blocked on v1 plants)
#   vv-canvas           Fabric canvas: digest-named versions, board.*
#   vv-browser          WebDriver BiDi (Vv::Browser); browser.inspect
#   mmg-acia           the ACIA tree: Node (an ancestry hierarchy), the Tree
#                       builders, the Markdown materialization and the graph
#                       projection under urn:mm:vocab/acia#
#
# WHAT DECLARING mmg-acia COSTS, recorded here because being in GEM_HOME is
# free and being in a Gemfile is not. Mmg::Acia::Engine is an isolated Rails
# engine whose `mmg_acia.migrations` initializer APPENDS its db/migrate to the
# host app's migration paths merely by being in the bundle -- five migrations
# today. An app that runs db:prepare on boot (the stock docker-entrypoint does,
# for `rails server`) creates those tables in production whether or not a line
# of it calls Mmg::Acia. That is the trap rails-osi-level-8's 37 migrations set
# for magentic-market-ai-site, which dropped the gem rather than carry a schema
# it did not use. Installing it here does NOT set that trap; declaring it does.
# Declare it when something actually mounts the tree.

# mmg-acia's materialized-path hierarchy (Mmg::Acia::Node). Declared here
# rather than left to `gem install mmg-acia` to drag in from rubygems at build
# time, because "consumers declare the gems they resolve" (6a7fac3) and a
# transitive install is the one resolution nobody wrote down.
gem "ancestry"

# In-pod L7 broker client (ADR 0065). rails-cpcp requires it lazily.
gem "nats-pure", "~> 2.5", require: false

# vv-browser BiDi (pure Ruby WebSocket). Installed with the gem; declared
# here so the platform lock contains it.
gem "websocket-driver", ">= 0.7"

group :development, :test do
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"
  gem "bundler-audit", require: false
  gem "brakeman", require: false
  gem "rubocop-rails-omakase", require: false
end
