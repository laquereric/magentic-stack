source "https://rubygems.org"

# rails-cpcp and rails-osi-level-8 come from the BASE image, where they are built
# from gems/ and installed into GEM_HOME. No path:, no git:, no bin/prepare
# vendoring step, and no GitHub access at build time.
gem "rails", "~> 8.0"
gem "puma"
gem "sqlite3", ">= 2.1"
gem "rails-cpcp"
gem "rails-osi-level-8"

# The shape gems rails-osi-level-8 resolves through ProfileCatalog. They are in
# the base image GEM_HOME, but bundler only loads what is DECLARED, and
# ProfileCatalog refuses a SHAPE_GEM that is absent from Gem.loaded_specs rather
# than falling back to a repo path -- "the repo_root fallback is not a
# declaration". Undeclared, BACK aborts at boot with
# "shape gem shapes-application is not in Gem.loaded_specs".
gem "shapes-level-8"
gem "shapes-application"

# The semantic editor, for the same reason and by the same rule: bundler loads
# only what is DECLARED. rails-osi-level-8 now depends on it -- Profile 9's
# board mounts it as a modal, using Prose to fill the editor's box and
# CanonicalId to decide which cards may carry a pencil -- so requiring
# rails-osi-level-8 without this in the bundle aborts at boot with
#
#   cannot load such file -- mmg-semantic-editor (LoadError)
#
# for every ROLE, which is exactly what gate-role-routes caught. Present in the
# base image's GEM_HOME already; this is the declaration, not the install.
gem "mmg-semantic-editor"

# The graph at the CPCP seam: graph.query / graph.count / graph.entries /
# graph.publish. Already built into the base image GEM_HOME by
# runtimes/rails-base/Dockerfile -- declaring it here is what makes those
# operations reachable on BACK. Until now MIND's harness called graph.query and
# BACK registered nothing by that name.
gem "mmg-graph"

# The RDF projection of the AR models: `triples do ... end` + project_on_save!.
# Storable is the sole go-forward graph DSL. Without this the pod's models have
# no way to reach GRAPH and the store stays empty.
gem "vv-graph"

# The canonical homes: Actor, Persona, Journey, Flow, Mission, Vision. They used
# to live in this app's app/models while calling themselves canonical.
gem "vv-base"

group :test do
  gem "rspec-rails", "~> 7.0"
  gem "rack-test"
end
