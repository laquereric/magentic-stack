<h1>Credential entry</h1>
<p class="sub">This page is <span class="tag">ROLE=config</span>.
It is vault's first caller. It may <strong>write</strong> a secret and
<strong>list presence</strong>. It may never read a value back.
<a href="/catalog">Catalogue</a> (metadata only; no discover, no verify).
<a href="/placements">Placements</a> (next-boot store paths).
<a href="/switch">Switch</a> (sources, pins, refresh, verify, test).</p>

<% if @refusal %>
  <p class="err">
    vault refused:
    <code><%= @refusal["reason"] %></code>
    because <%= @refusal["because"].inspect %>
    (HTTP <%= @refusal["status"] %>)
  </p>
<% end %>

<div class="card">
  <strong>Put a secret</strong> (vault.secret.put)
  <%= form_with url: "/secrets", method: :post do %>
    <input name="name" placeholder="name" required autocomplete="off">
    <input name="value" type="password" placeholder="value" required autocomplete="new-password">
    <button type="submit">Write via vault</button>
  <% end %>
</div>

<h3>Present (vault.secret.list)</h3>
<% if @items.empty? %><p class="sub">No secrets yet, or list refused above.</p><% end %>
<% @items.each do |item| %>
  <div class="card">
    <strong><%= item["name"] %></strong>
    <div class="sub">present=<%= item["present"] %> updated=<%= item["updated_at"] %></div>
  </div>
<% end %>
