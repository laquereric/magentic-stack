<div class="card">
  <strong>Panel 5 — Biography &amp; Provenance</strong> <span class="tag">P5</span>
  <div class="sub">PULLs: <code>l8.biography.get</code>, <code>l8.provenance.list</code>
    — actor=<%= @cyborg_iri %></div>

  <% bios = governance_items(@biography) %>
  <% edges = governance_items(@provenance_all) %>

  <% unless @biography["ok"] %><p class="err">biography refused: <%= @biography.dig("error", "reason") %></p><% end %>
  <% unless @provenance_all["ok"] %><p class="err">provenance refused</p><% end %>

  <h4>Actor timeline</h4>
  <% if bios.empty? %><p class="sub">No biography events yet.</p><% end %>
  <% bios.each do |ev| %>
    <div class="card">
      <div><strong><%= ev["subject_iri"] %></strong> <span class="tag"><%= ev["event_kind"] %></span></div>
      <div class="sub">
        asserted_by=<%= ev["asserted_by_iri"] %>
        from=<%= ev["valid_from"] || "—" %>
        to=<%= ev["valid_to"] || "—" %>
        recorded=<%= ev["recorded_at"] %>
      </div>
      <div class="sub"><code><%= ev["cid"] %></code></div>
      <div class="sub">statement=<%= ev["statement_json"].inspect %></div>
    </div>
  <% end %>

  <h4>Provenance adjacency</h4>
  <% if edges.empty? %><p class="sub">No provenance edges yet.</p><% end %>
  <% edges.each do |e| %>
    <div class="card">
      <div>
        <code><%= e["from_cid"] %></code>
        → <strong><%= e["predicate"] %></strong> →
        <code><%= e["to_cid"] || e["to_iri"] || "—" %></code>
      </div>
      <div class="sub">
        agent=<%= e["agent_iri"] || "—" %>
        activity=<%= e["activity_cid"] || "—" %>
        at=<%= e["asserted_at"] %>
      </div>
    </div>
  <% end %>
</div>
